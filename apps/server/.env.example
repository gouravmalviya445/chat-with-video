PORT = "8000"   # PORT for backend server
NODE_ENV="development"

DATABASE_URL="postgresql://username:password@localhost:5432/video_rag?schema=public"   # Postgres database URL

HF_API_KEY="your_hf_token"   # Hugging face api key

REDIS_HOST="localhost"  # enter redis host
REDIS_PORT="6379"   # enter redis port

BETTER_AUTH_SECRET="secret-key-for-auth"  # Better Auth
BETTER_AUTH_URL="http://localhost:8000"   # Base URL of our app

CORS_ORIGIN="http://localhost:3000" # Cors origin(the client url all req come from)

GOOGLE_GENERATIVE_AI_API_KEY="gemini_api_key" # Gemini Api Key