{
  "extends": "@repo/typescript-config/base",
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"],
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "paths": {
      "@/*": ["./src/*"],
      "@config/*": ["./src/config/*"],

      "@db": ["./src/db/index.ts"],
      "@db/*": ["./src/db/*"],

      "@ai/*": ["./src/ai/*"],
      "@repository/*": ["./src/repositories/*"],
      "@services/*": ["./src/services/*"],

      "@utils/*": ["./src/utils/*"],
      "@validators/*": ["./src/validators/*"],

      "@queue/*": ["./src/queue/*"],
      "@workers/*": ["./src/workers/*"],
    },
    "module": "ESNext",
    "moduleResolution": "bundler",
    // bun type issue
    "declaration": false,
    "declarationMap": false
  },
}
