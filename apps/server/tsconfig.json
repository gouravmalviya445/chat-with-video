{
  "extends": "@repo/typescript-config/base",
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"],
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "paths": {
      "@/*": ["./src/*"],
      "@config/*": ["./src/config/*"],
      "@db/*": ["./src/db/*"]
    },
    "module": "ESNext",
    "moduleResolution": "bundler",
  },
}
