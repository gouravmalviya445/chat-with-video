{
  "name": "chat-with-video-rag",
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "^2.10.8",
    "typescript": "5.9.2"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.1.40"
    }
  },
  "engines": {
    "node": ">=18"
  },
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
